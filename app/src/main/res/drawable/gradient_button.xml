<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <layer-list xmlns:android="http://schemas.android.com/apk/res/android">
        <!-- Sombra del botón -->
        <item>
            <shape>
                <solid android:color="#FFFFFF" /> <!-- Fondo blanco -->
                <corners android:radius="16dp" />
                <stroke android:width="2dp" android:color="#000000"/> <!-- Borde negro -->
            </shape>
        </item>

        <!-- Gradiente del botón -->
        <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
            <shape>
                <gradient
                    android:startColor="#FF6F00"
                    android:endColor="#FFA000"
                    android:angle="45" />
                <corners android:radius="16dp" />
            </shape>
        </item>
    </layer-list>


</selector>